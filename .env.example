# GrabMaps API Hackathon credentials — copy to .env and fill in real values
# Obtain from https://maps.grab.com/developer (API Keys + MCP URLs panels)

GRABMAPS_API_KEY=bm_your_api_key_here
GRABMAPS_MCP_TOKEN=mcp_your_mcp_token_here
GRABMAPS_MCP_URL=https://maps.grab.com/api/v1/mcp

# Developer docs portal (Basic Auth) — credentials shared at the hackathon kickoff
GRABMAPS_DOCS_BASIC_USER=your_docs_user_here
GRABMAPS_DOCS_BASIC_PASS=your_docs_password_here
